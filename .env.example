# Copy to .env and fill in. Never commit .env.

# --- Environment ---------------------------------------------------------
# development | production | test. Also selects config/<APP_ENV>.yaml if it exists.
APP_ENV=development
LOG_LEVEL=INFO
# json (production) or console (local development)
LOG_FORMAT=json

# --- Messenger -----------------------------------------------------------
BOT_TOKEN=
# telegram | bale | soroush
BOT_PLATFORM=telegram
# Optional: override the API base URL (leave empty to use the platform default)
# telegram: https://api.telegram.org   bale: https://tapi.bale.ai   soroush: https://api.splus.ir
BOT_API_BASE_URL=
# Max inline buttons per row. 0 = platform default (soroush: 2, others: 8)
BOT_MAX_BUTTONS_PER_ROW=0

# Platform user IDs that become SUPER_ADMIN the first time they start the bot (comma-separated)
BOOTSTRAP_SUPER_ADMIN_IDS=

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_DB=rasta_bot
POSTGRES_USER=rasta_bot
POSTGRES_PASSWORD=change-me
# Inside docker compose the host is "postgres"
DATABASE_URL=postgresql+asyncpg://rasta_bot:change-me@localhost:5432/rasta_bot

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Files ---------------------------------------------------------------
REPORTS_DIR=reports
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# --- Health check --------------------------------------------------------
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Optional: an extra policy YAML merged over config/default.yaml
POLICY_FILE=

# --- Docker build --------------------------------------------------------
# PyPI mirror for servers that cannot reach pypi.org
PIP_INDEX_URL=https://pypi.org/simple
