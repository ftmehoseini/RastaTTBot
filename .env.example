# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from the Soroush Plus bot builder
SOROUSH_BOT_TOKEN=

# Chat IDs of managers, comma-separated. They get everyone's reports and Excel files.
# Each person can see their own ID by sending /myid to the bot.
ADMIN_IDS=

# API base URL (default works for Soroush Plus)
SOROUSH_API_BASE=https://api.splus.ir/bot

# Office timezone and database location
TIMEZONE=Asia/Tehran
DB_PATH=data/attendance.sqlite3

# Workdays (sat,sun,mon,tue,wed,thu,fri)
WORKDAYS=sat,sun,mon,tue,wed,thu

# On workdays at this time, remind people who didn't record a check-out on an earlier day
REMINDER_TIME=10:00

# Automatic weekly report
WEEKLY_REPORT_DAY=thu
WEEKLY_REPORT_TIME=14:00

# A shift longer than this (hours) is rejected as a likely mistake
MAX_SHIFT_HOURS=16
